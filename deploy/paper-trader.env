# /etc/paper-trader.env — Environment variables for Paper Trader
# Install: sudo cp deploy/paper-trader.env /etc/paper-trader.env
# Secure:  sudo chmod 600 /etc/paper-trader.env
#          sudo chown paper-trader:paper-trader /etc/paper-trader.env

# Required: Angel One SmartAPI credentials (get from Angel One dashboard)
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_CODE=your_client_code_here
ANGEL_PIN=your_pin_here
ANGEL_TOTP_SECRET=your_totp_secret_here

# Optional: Override default paths
# DATA_DIR=/opt/paper-trader/data
# LOG_DIR=/opt/paper-trader/logs

# Optional: Python path (if using non-standard venv location)
# PYTHONPATH=/opt/paper-trader

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO